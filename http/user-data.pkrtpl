#cloud-config
autoinstall:
  version: 1
  keyboard:
    layout: us
    variant: ''
  locale: en_US.UTF-8
  timezone: America/New_York
  network:
    version: 2
    ethernets:
      ens18:
        dhcp4: false
        addresses:
          - ${baking_ip}/24
        routes:
          - to: default
            via: 192.168.0.1
        nameservers:
          addresses:
            - 8.8.8.8
            - 8.8.4.4
  identity:
    hostname: ubuntu-server
    password: ${hashed_password}
    realname: administrator
    username: administrator
  ssh:
    install-server: true
    allow-pw: true
  codecs:
    install: false
  drivers:
    install: false
  packages: []
  storage:
    layout:
      name: lvm
  updates: security
