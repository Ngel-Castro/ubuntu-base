#cloud-config
autoinstall:
  version: 1
  keyboard:
    layout: us
    variant: ''
  locale: en_US.UTF-8
  timezone: America/New_York
  network:
    version: 2
    ethernets:
      ens18:
        dhcp4: false
        addresses:
          - ${baking_ip}/${baking_prefix}
        routes:
          - to: default
            via: ${baking_gateway}
        nameservers:
          addresses:
%{ for dns in baking_dns ~}
            - ${dns}
%{ endfor ~}
  identity:
    hostname: ubuntu-server
    password: ${hashed_password}
    realname: ${admin_username}
    username: ${admin_username}
  ssh:
    install-server: true
    allow-pw: true
  codecs:
    install: false
  drivers:
    install: false
  packages: []
  storage:
    layout:
      name: lvm
      # The default "scaled" policy gives the root LV only part of the disk
      # (about half of a 32G disk), so a larger disk_size wouldn't reach /.
      sizing-policy: all
  updates: security
